{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "30 0 * * 1-5"
    },
    {
      "path": "/api/snapshot",
      "schedule": "0 8 * * 1-5"
    }
  ]
}
